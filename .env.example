# ===========================================================================
# 复制这个文件为 .env 然后填入你自己的值
#   copy .env.example .env
# .env 已经在 .gitignore 里，不会被提交到 GitHub。
# ===========================================================================

# ---------- 对话模型（必填）----------
# DeepSeek 官方地址，注意不要带 /v1
LLM_BASE_URL=https://api.deepseek.com

# 在这里填你的 API Key，从 https://platform.deepseek.com 获取
# 格式类似 sk-xxxxxxxxxxxxxxxx
LLM_API_KEY=

# 模型名：deepseek-flash（便宜够快，推荐先用它）
#         deepseek-v4-pro（更强，但贵约 4 倍，且不支持图片）
LLM_MODEL=deepseek-flash

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=60
# 失败后的额外重试次数（指数退避）
LLM_MAX_RETRIES=2

# ---------- 向量检索（可选）----------
# none  = 只做 BM25 关键词检索，零额外依赖，默认推荐先跑这个
# api   = 用别的服务商的 embeddings 接口（DeepSeek 官方没有 embeddings）
# local = 用本地模型（需先 pip install sentence-transformers，首次会下载权重）
EMBEDDING_BACKEND=none

# EMBEDDING_BACKEND=api 时必填，例如硅基流动 / 通义 / OpenAI
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=BAAI/bge-m3

# EMBEDDING_BACKEND=local 时的模型名
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---------- 检索参数（面试会问你怎么调的）----------
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=4
# 先圈多少候选再精排
CANDIDATE_K=20
# 0 = 纯 BM25，1 = 纯向量，中间值 = 混合。用 scripts/eval_rag.py 扫出来最优值
HYBRID_ALPHA=0

# 分词方式：bigram（默认）| jieba
#   bigram = 中文按相邻两字切。不依赖分词词典，保证「查询」和「文档」
#            切法一致。踩过的坑：jieba 把查询里的"小米"切成了"从小"+"米"，
#            而文档里"小米"是一个整词，两边对不上，正确答案直接掉出 top 4。
#   jieba  = 用 jieba 词典切词。词更准，但查询和文档的切法可能不一致。
# 两种模式都会剔除标点符号（问号曾经贡献了负例 89.5% 的分数）。
SEGMENT_MODE=bigram

# 最低分阈值：检索结果的原始 BM25 分低于它，就判定"没找到"，返回空。
# 这个值**不是拍脑袋定的**，扫描方法：
#   1. 跑 scripts/sweep_threshold.py，得到所有正例的最低分和所有负例的最高分
#   2. 在"零误杀正例"的前提下，取窗口中间值，留出安全余量
# 当前语料下：正例最低 13.592，负例最高 9.416 → 取中间值 11.5
# ⚠️ 换分词方式、或往 data/knowledge 里加大量新文件后，必须重新扫一遍
MIN_BM25_SCORE=11.5

# ---------- 展示 ----------
USD_TO_CNY=7.2

# ---------- 路径（一般不用改）----------
# DATA_DIR=data
